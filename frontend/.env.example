# Local development:
NEXT_PUBLIC_API_URL=http://localhost:3000/api/v1

# On Vercel, set this variable in Project Settings to your public backend URL,
# for example: https://api.askclo.com/api/v1

# Public Cloudflare Turnstile site key for the deployed frontend hostname.
NEXT_PUBLIC_TURNSTILE_SITE_KEY=replace_with_turnstile_site_key
