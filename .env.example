# Public frontend origin used for the Paystack checkout return URL.
APP_URL=http://localhost:3001

# Paystack API credentials. Use test keys during development.
PAYSTACK_SECRET_KEY=sk_test_replace_me
PAYSTACK_PUBLIC_KEY=pk_test_replace_me
PAYSTACK_BASE_URL=https://api.paystack.co

# Monthly Paystack plan codes created in the Paystack dashboard.
PAYSTACK_BASIC_PLAN_CODE=PLN_replace_me
PAYSTACK_PRO_PLAN_CODE=PLN_replace_me

# Optional override. Paystack signs webhooks with the secret key by default.
PAYSTACK_WEBHOOK_SECRET=
