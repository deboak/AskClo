# Public frontend origin used for the Paystack checkout return URL.
APP_URL=http://localhost:3001

# Email delivery. Gmail is suitable for an early, low-volume launch.
EMAIL_PROVIDER=gmail
GMAIL_USER=your_askclo_address@gmail.com
GMAIL_APP_PASSWORD=replace_with_google_app_password

# Optional SendGrid fallback. Set EMAIL_PROVIDER=sendgrid to use it.
SENDGRID_API_KEY=
SENDGRID_FROM_EMAIL=

# Paystack API credentials. Use test keys during development.
PAYSTACK_SECRET_KEY=sk_test_replace_me
PAYSTACK_PUBLIC_KEY=pk_test_replace_me
PAYSTACK_BASE_URL=https://api.paystack.co

# Monthly Paystack plan codes created in the Paystack dashboard.
PAYSTACK_BASIC_PLAN_CODE=PLN_replace_me
PAYSTACK_PRO_PLAN_CODE=PLN_replace_me

# Optional override. Paystack signs webhooks with the secret key by default.
PAYSTACK_WEBHOOK_SECRET=

# Cloudflare Turnstile server secret. Required in production for registration and OTP requests.
TURNSTILE_SECRET_KEY=replace_with_turnstile_secret

# A long random value used only to HMAC device and IP identifiers before database storage.
ANTI_ABUSE_HASH_SECRET=replace_with_at_least_32_random_characters

# Hard ceiling for all AI generation spend per UTC day.
MAX_DAILY_GENERATION_SPEND_USD=10
