{
  "name": "dress-me",
  "version": "1.0.0",
  "main": "index.js",
  "scripts": {
    "build": "tsc",
    "render:build": "npm run build && npm run db:migrate",
    "build:web": "npm --prefix frontend run build",
    "start": "node dist/server.js",
    "dev": "tsx watch src/server.ts",
    "dev:web": "npm --prefix frontend run dev",
    "db:new": "tsx ./node_modules/knex/bin/cli.js migrate:make --knexfile src/config/knexfile.ts -x ts",
    "db:migrate": "tsx ./node_modules/knex/bin/cli.js migrate:latest --knexfile src/config/knexfile.ts",
    "db:rollback": "tsx ./node_modules/knex/bin/cli.js migrate:rollback --knexfile src/config/knexfile.ts",
    "test": "echo \"Error: no test specified\" && exit 1"
  },
  "keywords": [],
  "author": "",
  "license": "ISC",
  "description": "",
  "dependencies": {
    "@aws-sdk/client-s3": "^3.1127.0",
    "@fal-ai/client": "^1.10.1",
    "bcrypt": "^6.0.0",
    "bullmq": "^6.1.2",
    "cors": "^2.8.6",
    "dotenv": "^17.4.2",
    "express": "^5.2.1",
    "express-rate-limit": "^8.6.2",
    "helmet": "^8.3.0",
    "ioredis": "^6.0.0",
    "jsonwebtoken": "^9.0.3",
    "knex": "^3.3.0",
    "logger": "^0.0.1",
    "objection": "^3.1.5",
    "pg": "^8.22.0",
    "pino": "^10.3.1",
    "rate-limit-redis": "^6.0.1",
    "redis": "^6.2.1",
    "zod": "^4.4.3"
  },
  "devDependencies": {
    "@types/bcrypt": "^6.0.0",
    "@types/cors": "^2.8.19",
    "@types/express": "^5.0.6",
    "@types/jsonwebtoken": "^9.0.10",
    "@types/node": "^26.1.2",
    "@types/pg": "^8.20.4",
    "pino-pretty": "^13.1.3",
    "tsx": "^4.23.10",
    "typescript": "^7.0.2"
  }
}
